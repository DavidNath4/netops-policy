{
  "name": "netops-policy-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NetOps Policy Manager — Nuxt 4 fullstack application for network ACL and route policy management.",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx database/seeds/seed.ts"
  },
  "dependencies": {
    "@nuxt/ui": "4.11.1",
    "argon2": "0.45.1",
    "drizzle-orm": "0.45.2",
    "nuxt": "4.5.2",
    "otplib": "^13.5.0",
    "postgres": "3.4.9",
    "qrcode": "^1.5.4",
    "tailwindcss": "4.3.3",
    "vue": "3.5.42",
    "vue-router": "5.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@types/node": "24.13.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "6.0.8",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "fast-check": "4.9.0",
    "happy-dom": "20.14.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "vue-demi@0.14.10": true
  }
}
