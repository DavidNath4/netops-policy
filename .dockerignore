# Dependencies & build output — rebuilt inside the image
node_modules
.nuxt
.nitro
.output
.data
.cache
dist

# Version control & CI
.git
.gitignore
.gitattributes

# Secrets & local machine config — never bake into the image
.env
.env.*
!.env.example
.kiro

# Local workflow artifacts & design references — not needed at runtime
.agents
.design-ref

# Tests & tooling
tests
coverage
*.lcov
.vitest
.nyc_output
eslint.config.mjs

# Logs & scratch files
logs
*.log
tc*.log
*.tmp
tokens.txt
gitstat.txt
admin.html
probe.txt

# Editors / OS
.vscode
.idea
.DS_Store
Thumbs.db

# Docker & build scripts themselves
Dockerfile
.dockerignore
build-and-push.bat

# Docs (optional at runtime)
README.md
AGENTS.md

# Manual production SQL (run by hand in DBeaver — not part of the app build)
database/prod-*.sql
